# Copier vers .env (local) ou renseigner en variables d'environnement Render/PythonAnywhere.
# NE JAMAIS commiter un vrai .env contenant des secrets.

# Flask
SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire
# 1 en production (HTTPS), 0 en local (http://127.0.0.1:5000)
COOKIE_SECURE=1

# Base de données (défaut : sqlite local unjed.db). Ex. Postgres Render :
# DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_URL=

# Comptes admin créés au démarrage (recommandé : 1 seul, puis gérez via seed_admins.py)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=UNJED-BENIN

# Origines frontend supplémentaires autorisées (séparées par des virgules)
EXTRA_ORIGINS=https://unjedbenin.org,https://www.unjedbenin.org

# Emails (Gmail : mot de passe d'APPLICATION, jamais le mot de passe normal)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=unjedbenin@gmail.com
MAIL_PASSWORD=
MAIL_FROM=unjedbenin@gmail.com
ADMIN_NOTIFY_EMAIL=unjedbenin@gmail.com

# Anti-abus (défaut : mémoire du processus ; Redis recommandé en multi-instances)
# RATELIMIT_STORAGE_URI=redis://...
